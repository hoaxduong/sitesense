{
  "name": "@sitesense/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run --frozen uvicorn sitesense_api.main:app --reload --host 127.0.0.1 --port 8000",
    "start": "uv run --frozen uvicorn sitesense_api.main:app --host 0.0.0.0 --port 8000",
    "build": "uv build --out-dir dist",
    "lint": "uv run --frozen ruff check . && uv run --frozen ruff format --check .",
    "typecheck": "uv run --frozen mypy src",
    "test": "uv run --frozen pytest",
    "format": "uv run --frozen ruff format .",
    "openapi": "uv run --frozen python -m sitesense_api.openapi"
  }
}
