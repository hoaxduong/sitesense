# Local development only. Copy to .env, which is ignored by Git.
# Replace the password in BOTH places below.
POSTGRES_DB=sitesense
POSTGRES_USER=sitesense
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sitesense:replace-with-local-password@127.0.0.1:5432/sitesense
