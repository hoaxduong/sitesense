# Local development only. Copy to .env, which is ignored by Git.
# Replace the password in BOTH places below.
# Optional AI advisor on the Site recommendations page (local Ollama example; the key is
# only needed for hosted providers). Leave unset to use the offline summary.
# SITESENSE_AI_BASE_URL=http://localhost:11434/v1
# SITESENSE_AI_MODEL=qwen2.5:14b
# SITESENSE_AI_TIMEOUT=150
POSTGRES_DB=sitesense
POSTGRES_USER=sitesense
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sitesense:replace-with-local-password@127.0.0.1:5432/sitesense
