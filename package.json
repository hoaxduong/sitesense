{
  "name": "sitesense",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@sitesense/web",
    "dev:api": "turbo run dev --filter=@sitesense/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "format": "prettier --write . && turbo run format",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  }
}
